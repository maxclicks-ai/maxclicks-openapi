{
  "name": "maxclicks-openapi",
  "version": "1.0.0",
  "description": "The official OpenAPI 3.1 specification for the maxclicks Public API v1",
  "author": "maxclicks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "bundle": "redocly bundle openapi.yaml -o dist/openapi.yaml",
    "bundle:json": "redocly bundle openapi.yaml -o dist/openapi.json",
    "preview": "redocly preview-docs openapi.yaml",
    "build-docs": "redocly build-docs openapi.yaml -o dist/index.html"
  },
  "keywords": [
    "maxclicks",
    "openapi",
    "swagger",
    "api",
    "specification",
    "rest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxclicks-ai/maxclicks-openapi"
  },
  "homepage": "https://github.com/maxclicks-ai/maxclicks-openapi#readme",
  "bugs": {
    "url": "https://github.com/maxclicks-ai/maxclicks-openapi/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5"
  }
}
